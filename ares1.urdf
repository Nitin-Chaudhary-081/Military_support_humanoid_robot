    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.28" ixy="0" ixz="0" iyy="0.28" iyz="0" izz="0.09"/>
      <origin xyz="0 0 -0.24"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.24"/>
      <geometry>
        <mesh filename="package://ares1_description/meshes/visual/shin.stl"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ares1_description/meshes/collision/shin_col.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_knee" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <origin rpy="0 0 0" xyz="0 0 -0.52"/>
    <axis xyz="0 1 0"/>
    <limit effort="360" lower="0" upper="2.443" velocity="2.5"/>
  </joint>
  <link name="armour_right_shin">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.008"/>
      <origin xyz="0 0 0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.07 0 -0.24"/>
      <geometry>
        <box size="0.015 0.10 0.28"/>
      </geometry>
      <material name="flat_black"/>
    </visual>
  </link>
  <joint name="armour_right_shin_joint" type="fixed">
    <parent link="right_shin"/>
    <child link="armour_right_shin"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ankle pitch -> roll -->
  <link name="right_ankle_pitch">
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.004"/>
    </inertial>
  </link>
  <joint name="right_ankle_pitch" type="revolute">
    <parent link="right_shin"/>
    <child link="right_ankle_pitch"/>
    <origin rpy="0 0 0" xyz="0 0 -0.48"/>
    <axis xyz="0 1 0"/>
    <limit effort="220" lower="-0.698" upper="0.698" velocity="3.0"/>
  </joint>
  <link name="right_ankle_roll">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.003"/>
    </inertial>
  </link>
  <joint name="right_ankle_roll" type="revolute">
    <parent link="right_ankle_pitch"/>
    <child link="right_ankle_roll"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="160" lower="-0.349" upper="0.349" velocity="3.0"/>
  </joint>
  <link name="right_foot">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.05"/>
      <origin xyz="0.05 0 -0.02"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.05 0 -0.02"/>
      <geometry>
        <mesh filename="package://ares1_description/meshes/visual/foot.stl"/>
      </geometry>
      <material name="gunmetal"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://ares1_description/meshes/collision/foot_col.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_foot_joint" type="fixed">
    <parent link="right_ankle_roll"/>
    <child link="right_foot"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ========== SENSORS arc.md 530 ========== -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control">
      <parameters>config/ares1_controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <gazebo reference="head">
    <!-- Livox MID-360 10Hz 360 point cloud on dome -->
    <sensor name="mid360" type="gpu_lidar">
      <lidar>
        <scan>
          <horizontal>
            <samples>1024</samples>
            <min_angle>-3.1416</min_angle>
            <max_angle>3.1416</max_angle>
          </horizontal>
          <vertical>
            <samples>64</samples>
            <min_angle>-0.5236</min_angle>
            <max_angle>0.5236</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>70</max>
        </range>
      </lidar>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/ares1/sensors/lidar/points</topic>
    </sensor>
    <!-- D435i front -->
    <sensor name="front_stereo" type="camera">
      <camera>
        <image>
          <width>1280</width>
          <height>720</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>80</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/ares1/sensors/camera/front/image</topic>
    </sensor>
    <sensor name="thermal" type="camera">
      <camera>
        <image>
          <width>640</width>
          <height>512</height>
        </image>
      </camera>
      <always_on>true</always_on>
      <update_rate>60</update_rate>
      <topic>/ares1/sensors/camera/thermal/image</topic>
    </sensor>
    <sensor name="rear_wide" type="camera">
      <camera>
        <image>
          <width>1920</width>
          <height>1080</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>60</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>60</update_rate>
      <topic>/ares1/sensors/camera/rear/image</topic>
    </sensor>
  </gazebo>
  <gazebo reference="chest">
    <sensor name="imu_chest" type="imu">
      <always_on>true</always_on>
      <update_rate>800</update_rate>
      <topic>/ares1/sensors/imu/data</topic>
    </sensor>
    <sensor name="acoustic_array" type="logical_camera">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/ares1/sensors/acoustic/direction</topic>
    </sensor>
  </gazebo>
  <gazebo reference="left_foot">
    <sensor name="left_ft" type="force_torque">
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <topic>/ares1/sensors/foot/left/ft</topic>
    </sensor>
  </gazebo>
  <gazebo reference="right_foot">
    <sensor name="right_ft" type="force_torque">
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <topic>/ares1/sensors/foot/right/ft</topic>
    </sensor>
  </gazebo>
  <gazebo reference="shield">
    <material>Gazebo/Charcoal</material>
  </gazebo>
</robot>
