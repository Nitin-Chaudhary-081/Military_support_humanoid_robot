<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ares1">
  <!-- ARES-1 v1.0 arc.md complete spec — 2430mm 447kg 26-DOF mesh STL -->
  <!-- Meshes generated procedural at src/ares1_description/meshes/visual/*.stl scale 1 (meters) -->
  <!-- Height stack arc.md: foot80 + shin480 + knee60 + thigh520 + hip60 + pelvis180 + abdomen220 + chest380 + neck120 + head240 + dome90 = 2430 -->
  <!-- Weight budget arc.md: 447kg detailed -->
  <xacro:property name="mass_head" value="12.0"/>
  <xacro:property name="mass_neck" value="6.0"/>
  <xacro:property name="mass_chest" value="32.0"/>
  <xacro:property name="mass_abdomen_ring" value="4.0"/>
  <xacro:property name="mass_pelvis" value="22.0"/>
  <xacro:property name="mass_shoulder_yoke" value="14.0"/>
  <xacro:property name="mass_upper_arm" value="6.0"/>
  <xacro:property name="mass_forearm" value="4.0"/>
  <xacro:property name="mass_hand" value="3.0"/>
  <xacro:property name="mass_thigh" value="14.0"/>
  <xacro:property name="mass_shin" value="10.0"/>
  <xacro:property name="mass_foot" value="5.0"/>
  <xacro:property name="mass_battery" value="110.0"/>
  <xacro:property name="mass_shield" value="18.0"/>
  <xacro:property name="mass_drone_fixed" value="1.4"/>
  <xacro:property name="mass_drone_quad" value="0.85"/>

  <!-- Materials Appendix B arc.md:708 -->
  <material name="dark_grey"><color rgba="0.176 0.176 0.188 1.0"/></material>
  <material name="flat_black"><color rgba="0.11 0.11 0.118 1.0"/></material>
  <material name="gunmetal"><color rgba="0.282 0.282 0.298 1.0"/></material>
  <material name="visor_blue"><color rgba="0.078 0.157 0.314 1.0"/></material>
  <material name="olive_drab"><color rgba="0.333 0.353 0.235 1.0"/></material>
  <material name="charcoal"><color rgba="0.216 0.216 0.227 1.0"/></material>

  <!-- ========== PELVIS (base_link) — hex 460x260x180 22kg ========== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass_pelvis}"/>
      <inertia ixx="0.85" ixy="0" ixz="0" iyy="0.92" iyz="0" izz="0.78"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://ares1_description/meshes/visual/pelvis.stl" scale="1 1 1"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://ares1_description/meshes/collision/pelvis_col.stl" scale="1 1 1"/></geometry>
    </collision>
  </link>

  <!-- Battery 110kg chest core — fixed to chest (low CoM) -->
  <link name="battery_pack">
    <inertial><mass value="${mass_battery}"/><inertia ixx="4.2" ixy="0" ixz="0" iyy="3.8" iyz="0" izz="2.1"/><origin xyz="0 0 0"/></inertial>
  </link>

  <!-- ========== ABDOMEN 3 rings (abdomen 220 = 60+25+60+25+60) 12kg total ========== -->
  <link name="abdomen_ring1">
    <inertial><mass value="${mass_abdomen_ring}"/><inertia ixx="0.12" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.08"/><origin xyz="0 0 0"/></inertial>
    <visual><geometry><mesh filename="package://ares1_description/meshes/visual/abdomen_ring.stl" scale="1 1 1"/></geometry><material name="dark_grey"/></visual>
    <collision><geometry><mesh filename="package://ares1_description/meshes/collision/abdomen_ring_col.stl"/></geometry></collision>
  </link>
  <joint name="abdomen1_fixed" type="fixed"><parent link="base_link"/><child link="abdomen_ring1"/><origin xyz="0 0 0.115" rpy="0 0 0"/></joint>

  <link name="abdomen_ring2">
    <inertial><mass value="${mass_abdomen_ring}"/><inertia ixx="0.12" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.08"/><origin xyz="0 0 0"/></inertial>
    <visual><geometry><mesh filename="package://ares1_description/meshes/visual/abdomen_ring.stl"/></geometry><material name="flat_black"/></visual>
    <collision><geometry><mesh filename="package://ares1_description/meshes/collision/abdomen_ring_col.stl"/></geometry></collision>
  </link>
  <joint name="abdomen2_fixed" type="fixed"><parent link="abdomen_ring1"/><child link="abdomen_ring2"/><origin xyz="0 0 0.085" rpy="0 0 0"/></joint>

  <link name="abdomen_ring3">
    <inertial><mass value="${mass_abdomen_ring}"/><inertia ixx="0.12" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.08"/><origin xyz="0 0 0"/></inertial>
    <visual><geometry><mesh filename="package://ares1_description/meshes/visual/abdomen_ring.stl"/></geometry><material name="dark_grey"/></visual>
    <collision><geometry><mesh filename="package://ares1_description/meshes/collision/abdomen_ring_col.stl"/></geometry></collision>
  </link>
  <joint name="abdomen3_fixed" type="fixed"><parent link="abdomen_ring2"/><child link="abdomen_ring3"/><origin xyz="0 0 0.085" rpy="0 0 0"/></joint>

  <!-- ========== CHEST 520->440x280x380 32kg trapezoidal ========== -->
  <link name="chest">
    <inertial><mass value="${mass_chest}"/><inertia ixx="1.2" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="0.9"/><origin xyz="0 0 0"/></inertial>
    <visual><geometry><mesh filename="package://ares1_description/meshes/visual/chest.stl"/></geometry><material name="dark_grey"/></visual>
    <collision><geometry><mesh filename="package://ares1_description/meshes/collision/chest_col.stl"/></geometry></collision>
  </link>
  <joint name="chest_joint" type="fixed"><parent link="abdomen_ring3"/><child link="chest"/><origin xyz="0 0 0.225" rpy="0 0 0"/></joint>
  <joint name="battery_joint" type="fixed"><parent link="chest"/><child link="battery_pack"/><origin xyz="0 0 -0.05" rpy="0 0 0"/></joint>

  <!-- Chest armour plate 6.2kg curved (separate link for Foxglove toggle) -->
  <link name="armour_chest_front">
    <inertial><mass value="6.2"/><inertia ixx="0.15" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.10"/><origin xyz="0 0 0"/></inertial>
    <visual><origin xyz="0.14 0 0" rpy="0 0 0"/><geometry><box size="0.02 0.32 0.28"/></geometry><material name="flat_black"/></visual>
  </link>
  <joint name="armour_chest_joint" type="fixed"><parent link="chest"/><child link="armour_chest_front"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <!-- Additional armour per arc.md 8.1 to reach 27kg total (chest 6.2 already + head 1.8 + arm 1.8 + leg 4 = 13.8, need +13.2) -->
  <link name="armour_back"><inertial><mass value="2.4"/><inertia ixx="0.06" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.04"/><origin xyz="0 0 0"/></inertial><visual><origin xyz="-0.14 0 0" rpy="0 0 0"/><geometry><box size="0.02 0.28 0.30"/></geometry><material name="flat_black"/></visual></link>
  <joint name="armour_back_joint" type="fixed"><parent link="chest"/><child link="armour_back"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="armour_shoulder_caps"><inertial><mass value="1.4"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.02"/><origin xyz="0 0 0"/></inertial></link>
  <joint name="armour_shoulder_joint" type="fixed"><parent link="shoulder_yoke"/><child link="armour_shoulder_caps"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <link name="armour_extra"><inertial><mass value="9.4"/><inertia ixx="0.12" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.08"/></inertial></link>
  <joint name="armour_extra_joint" type="fixed"><parent link="base_link"/><child link="armour_extra"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <!-- AI compute 18kg fixed to chest -->
  <link name="ai_compute"><inertial><mass value="18.0"/><inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.3"/><origin xyz="0 0 0"/></inertial></link>
  <joint name="ai_fixed" type="fixed"><parent link="chest"/><child link="ai_compute"/><origin xyz="-0.10 0 0.10" rpy="0 0 0"/></joint>
  <!-- Wiring harness 8kg -->
  <link name="wiring_harness"><inertial><mass value="8.0"/><inertia ixx="0.12" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.08"/><origin xyz="0 0 0"/></inertial></link>
  <joint name="wiring_joint" type="fixed"><parent link="chest"/><child link="wiring_harness"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <!-- Hydraulic system 30kg lines+fluid+actuators fixed to pelvis -->
  <link name="hydraulic_system"><inertial><mass value="30.0"/><inertia ixx="1.1" ixy="0" ixz="0" iyy="1.1" iyz="0" izz="0.9"/><origin xyz="0 0 0"/></inertial></link>
  <joint name="hydraulic_joint" type="fixed"><parent link="base_link"/><child link="hydraulic_system"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <!-- Fasteners + misc 12kg -->
  <link name="fasteners"><inertial><mass value="4.8"/><inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.06"/><origin xyz="0 0 0"/></inertial></link>
  <joint name="fasteners_joint" type="fixed"><parent link="base_link"/><child link="fasteners"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <!-- ========== SHOULDER YOKE 640 span 80x120 14kg + pods ========== -->
  <link name="shoulder_yoke">
    <inertial><mass value="${mass_shoulder_yoke}"/><inertia ixx="0.45" ixy="0" ixz="0" iyy="0.85" iyz="0" izz="0.65"/><origin xyz="0 0 0"/></inertial>
    <visual><geometry><mesh filename="package://ares1_description/meshes/visual/shoulder_yoke.stl"/></geometry><material name="gunmetal"/></visual>
    <collision><geometry><mesh filename="package://ares1_description/meshes/collision/shoulder_yoke_col.stl"/></geometry></collision>
  </link>
  <joint name="yoke_joint" type="fixed"><parent link="chest"/><child link="shoulder_yoke"/><origin xyz="0 0 0.235" rpy="0 0 0"/></joint>

  <!-- Missile pods 400x80x80 each 1.2kg + 3 missiles 4kg each -->
  <link name="pod_left"><inertial><mass value="13.2"/><inertia ixx="0.18" ixy="0" ixz="0" iyy="0.18" iyz="0" izz="0.06"/><origin xyz="0 0 0"/></inertial><visual><geometry><mesh filename="package://ares1_description/meshes/visual/missile_pod.stl"/></geometry><material name="olive_drab"/></visual><collision><geometry><mesh filename="package://ares1_description/meshes/collision/missile_pod_col.stl"/></geometry></collision></link>
  <joint name="pod_left_joint" type="revolute"><parent link="shoulder_yoke"/><child link="pod_left"/><origin xyz="0 0.28 0.06" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="0" upper="0.785" effort="30" velocity="1.0"/></joint>
  <link name="pod_right"><inertial><mass value="13.2"/><inertia ixx="0.18" ixy="0" ixz="0" iyy="0.18" iyz="0" izz="0.06"/><origin xyz="0 0 0"/></inertial><visual><geometry><mesh filename="package://ares1_description/meshes/visual/missile_pod.stl"/></geometry><material name="olive_drab"/></visual><collision><geometry><mesh filename="package://ares1_description/meshes/collision/missile_pod_col.stl"/></geometry></collision></link>
  <joint name="pod_right_joint" type="revolute"><parent link="shoulder_yoke"/><child link="pod_right"/><origin xyz="0 -0.28 0.06" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="0" upper="0.785" effort="30" velocity="1.0"/></joint>

  <!-- ========== NECK 70->90x120 6kg 2-DOF ========== -->
  <link name="neck_base">
    <inertial><mass value="2.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/><origin xyz="0 0 0"/></inertial>
    <visual><geometry><mesh filename="package://ares1_description/meshes/visual/neck.stl"/></geometry><material name="gunmetal"/></visual>
    <collision><geometry><mesh filename="package://ares1_description/meshes/collision/neck_col.stl"/></geometry></collision>
  </link>
  <joint name="neck_yaw" type="revolute"><parent link="chest"/><child link="neck_base"/><origin xyz="0 0 0.250" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-1.57" upper="1.57" effort="120" velocity="2.0"/><dynamics damping="5" friction="1"/></joint>
  <link name="neck_pitch_link"><inertial><mass value="4.0"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.02"/><origin xyz="0 0 0.06"/></inertial></link>
  <joint name="neck_pitch" type="revolute"><parent link="neck_base"/><child link="neck_pitch_link"/><origin xyz="0 0 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-0.524" upper="0.524" effort="120" velocity="2.0"/></joint>

  <!-- ========== HEAD 280x260x240 + dome r90 12kg ========== -->
  <link name="head">
    <inertial><mass value="${mass_head}"/><inertia ixx="0.18" ixy="0" ixz="0" iyy="0.16" iyz="0" izz="0.12"/><origin xyz="0 0 0.04"/></inertial>
    <visual><geometry><mesh filename="package://ares1_description/meshes/visual/head.stl"/></geometry><material name="dark_grey"/></visual>
    <collision><geometry><mesh filename="package://ares1_description/meshes/collision/head_col.stl"/></geometry></collision>
  </link>
  <joint name="head_joint" type="fixed"><parent link="neck_pitch_link"/><child link="head"/><origin xyz="0 0 0.07" rpy="0 0 0"/></joint>

  <!-- Head armour + visor -->
  <link name="armour_head_front"><inertial><mass value="1.8"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/><origin xyz="0 0 0"/></inertial><visual><origin xyz="0.12 0 0.02" rpy="0 0 0"/><geometry><box size="0.02 0.22 0.14"/></geometry><material name="flat_black"/></visual></link>
  <joint name="armour_head_joint" type="fixed"><parent link="head"/><child link="armour_head_front"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <!-- Sensor dome -->
  <link name="sensor_dome"><inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial><visual><origin xyz="0 0 0.14" rpy="0 0 0"/><geometry><sphere radius="0.09"/></geometry><material name="visor_blue"/></visual></link>
  <joint name="dome_joint" type="fixed"><parent link="head"/><child link="sensor_dome"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <!-- ========== DRONE BAYS (left fixed 1.4kg, right quad 0.85kg) per arc.md 459 ========== -->
  <link name="drone_fixed_wing"><inertial><mass value="${mass_drone_fixed}"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.015"/><origin xyz="0 0 0"/></inertial><visual><geometry><mesh filename="package://ares1_description/meshes/visual/drone_fixed_wing.stl"/></geometry><material name="flat_black"/></visual></link>
  <joint name="drone1_fixed" type="fixed"><parent link="chest"/><child link="drone_fixed_wing"/><origin xyz="-0.16 0.11 -0.08" rpy="0 0 0"/></joint>
  <link name="drone_quad"><inertial><mass value="${mass_drone_quad}"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.008"/><origin xyz="0 0 0"/></inertial><visual><geometry><mesh filename="package://ares1_description/meshes/visual/drone_quad.stl"/></geometry><material name="flat_black"/></visual></link>
  <joint name="drone2_fixed" type="fixed"><parent link="chest"/><child link="drone_quad"/><origin xyz="-0.16 -0.11 -0.08" rpy="0 0 0"/></joint>

  <!-- ========== SHIELD 1200x700x48 18kg B4C+UHMWPE+Ti ========== -->
  <link name="shield">
    <inertial><mass value="${mass_shield}"/><inertia ixx="2.1" ixy="0" ixz="0" iyy="0.9" iyz="0" izz="2.4"/><origin xyz="0 0 0.60"/></inertial>
    <visual><geometry><mesh filename="package://ares1_description/meshes/visual/shield.stl"/></geometry><material name="charcoal"/></visual>
    <collision><geometry><mesh filename="package://ares1_description/meshes/collision/shield_col.stl"/></geometry></collision>
  </link>
  <joint name="shield_pivot" type="revolute">
    <parent link="shoulder_yoke"/><child link="shield"/>
    <origin xyz="0 0.32 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.83" effort="500" velocity="3.5"/>
    <dynamics damping="12" friction="3"/>
  </joint>

  <!-- ========== ARMS 26-DOF detailed ========== -->
  <xacro:macro name="arm" params="prefix y">
    <!-- shoulder 3 DOF: yaw->roll->pitch with dummy intermediates -->
    <link name="${prefix}_shoulder_yaw"><inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial></link>
    <joint name="${prefix}_shoulder_yaw" type="revolute">
      <parent link="shoulder_yoke"/><child link="${prefix}_shoulder_yaw"/>
      <origin xyz="0 ${y} 0.0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/><limit lower="-0.785" upper="0.785" effort="180" velocity="2.0"/>
    </joint>
    <link name="${prefix}_shoulder_roll"><inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial></link>
    <joint name="${prefix}_shoulder_roll" type="revolute">
      <parent link="${prefix}_shoulder_yaw"/><child link="${prefix}_shoulder_roll"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/><limit lower="-1.57" upper="1.57" effort="220" velocity="2.0"/>
    </joint>
    <link name="${prefix}_shoulder_pitch"><inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
    <joint name="${prefix}_shoulder_pitch" type="revolute">
      <parent link="${prefix}_shoulder_roll"/><child link="${prefix}_shoulder_pitch"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/><limit lower="-3.14" upper="3.14" effort="280" velocity="2.5"/>
    </joint>
    <!-- upper arm octagonal 380 -->
    <link name="${prefix}_upper_arm">
      <inertial><mass value="${mass_upper_arm}"/><inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.04"/><origin xyz="0 0 -0.19"/></inertial>
      <visual><origin xyz="0 0 -0.19" rpy="0 0 0"/><geometry><mesh filename="package://ares1_description/meshes/visual/upper_arm.stl"/></geometry><material name="dark_grey"/></visual>
      <collision><geometry><mesh filename="package://ares1_description/meshes/collision/upper_arm_col.stl"/></geometry></collision>
    </link>
    <joint name="${prefix}_upper_fixed" type="fixed"><parent link="${prefix}_shoulder_pitch"/><child link="${prefix}_upper_arm"/><origin xyz="0 0 -0.04" rpy="0 0 0"/></joint>
    <link name="armour_${prefix}_upper"><inertial><mass value="0.4"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial><visual><origin xyz="0 0.02 -0.19" rpy="0 0 0"/><geometry><box size="0.008 0.04 0.20"/></geometry><material name="flat_black"/></visual></link>
    <joint name="armour_${prefix}_upper_joint" type="fixed"><parent link="${prefix}_upper_arm"/><child link="armour_${prefix}_upper"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
    <!-- elbow -->
    <link name="${prefix}_elbow_link"><inertial><mass value="0.3"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/></inertial></link>
    <joint name="${prefix}_elbow" type="revolute">
      <parent link="${prefix}_upper_arm"/><child link="${prefix}_elbow_link"/>
      <origin xyz="0 0 -0.38" rpy="0 0 0"/>
      <axis xyz="0 1 0"/><limit lower="0" upper="2.53" effort="200" velocity="2.5"/>
    </joint>
    <!-- forearm 340 -->
    <link name="${prefix}_forearm">
      <inertial><mass value="${mass_forearm}"/><inertia ixx="0.06" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.03"/><origin xyz="0 0 -0.17"/></inertial>
      <visual><origin xyz="0 0 -0.17" rpy="0 0 0"/><geometry><mesh filename="package://ares1_description/meshes/visual/forearm.stl"/></geometry><material name="dark_grey"/></visual>
      <collision><geometry><mesh filename="package://ares1_description/meshes/collision/forearm_col.stl"/></geometry></collision>
    </link>
    <joint name="${prefix}_forearm_fixed" type="fixed"><parent link="${prefix}_elbow_link"/><child link="${prefix}_forearm"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
    <link name="armour_${prefix}_forearm"><inertial><mass value="0.5"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.003"/></inertial><visual><origin xyz="0 0 -0.17" rpy="0 0 0"/><geometry><box size="0.012 0.06 0.20"/></geometry><material name="flat_black"/></visual></link>
    <joint name="armour_${prefix}_forearm_joint" type="fixed"><parent link="${prefix}_forearm"/><child link="armour_${prefix}_forearm"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
    <!-- weapons per arm: left rifle SCAR-H 4.6kg 880mm, right grenade M320 1.5kg -->
    <xacro:if value="${prefix == 'left'}">
      <link name="${prefix}_rifle"><inertial><mass value="4.6"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.02"/><origin xyz="0.44 0 0"/></inertial><visual><origin xyz="0.44 0 0" rpy="0 1.57 0"/><geometry><box size="0.88 0.04 0.06"/></geometry><material name="olive_drab"/></visual></link>
      <joint name="${prefix}_rifle_joint" type="fixed"><parent link="${prefix}_forearm"/><child link="${prefix}_rifle"/><origin xyz="0 0 -0.34" rpy="0 0 0"/></joint>
    </xacro:if>
    <xacro:if value="${prefix == 'right'}">
      <link name="${prefix}_launcher"><inertial><mass value="1.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/><origin xyz="0 0 -0.12"/></inertial><visual><origin xyz="0 0 -0.12" rpy="0 1.57 0"/><geometry><box size="0.23 0.04 0.04"/></geometry><material name="olive_drab"/></visual></link>
      <joint name="${prefix}_launcher_joint" type="fixed"><parent link="${prefix}_forearm"/><child link="${prefix}_launcher"/><origin xyz="0.02 0 -0.34" rpy="0 0 0"/></joint>
    </xacro:if>
    <!-- wrist 2 DOF -->
    <link name="${prefix}_wrist_pitch"><inertial><mass value="0.6"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/></inertial></link>
    <joint name="${prefix}_wrist_pitch" type="revolute">
      <parent link="${prefix}_forearm"/><child link="${prefix}_wrist_pitch"/>
      <origin xyz="0 0 -0.34" rpy="0 0 0"/>
      <axis xyz="0 1 0"/><limit lower="-1.047" upper="1.047" effort="80" velocity="3.0"/>
    </joint>
    <link name="${prefix}_wrist_roll"><inertial><mass value="0.5"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/></inertial></link>
    <joint name="${prefix}_wrist_roll" type="revolute">
      <parent link="${prefix}_wrist_pitch"/><child link="${prefix}_wrist_roll"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/><limit lower="-0.524" upper="0.524" effort="60" velocity="3.0"/>
    </joint>
    <link name="${prefix}_hand">
      <inertial><mass value="${mass_hand}"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/><origin xyz="0 0 -0.08"/></inertial>
      <visual><origin xyz="0 0 -0.08" rpy="0 0 0"/><geometry><mesh filename="package://ares1_description/meshes/visual/hand.stl"/></geometry><material name="gunmetal"/></visual>
      <collision><geometry><mesh filename="package://ares1_description/meshes/collision/hand_col.stl"/></geometry></collision>
    </link>
    <joint name="${prefix}_hand_joint" type="fixed"><parent link="${prefix}_wrist_roll"/><child link="${prefix}_hand"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  </xacro:macro>

  <xacro:arm prefix="left" y="0.32"/>
  <xacro:arm prefix="right" y="-0.32"/>

  <!-- ========== LEGS 12 DOF (hip 3 + knee1 + ankle2 per leg) ========== -->
  <xacro:macro name="leg" params="prefix y">
    <!-- hip yaw -> roll -> pitch dummy chain -->
    <link name="${prefix}_hip_yaw"><inertial><mass value="0.8"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial></link>
    <joint name="${prefix}_hip_yaw" type="revolute">
      <parent link="base_link"/><child link="${prefix}_hip_yaw"/>
      <origin xyz="0 ${y} -0.085" rpy="0 0 0"/>
      <axis xyz="0 0 1"/><limit lower="-0.524" upper="0.524" effort="200" velocity="2.0"/>
    </joint>
    <link name="${prefix}_hip_roll"><inertial><mass value="0.8"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/></inertial></link>
    <joint name="${prefix}_hip_roll" type="revolute">
      <parent link="${prefix}_hip_yaw"/><child link="${prefix}_hip_roll"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/><limit lower="-0.785" upper="0.785" effort="280" velocity="2.0"/>
    </joint>
    <link name="${prefix}_hip_pitch"><inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
    <joint name="${prefix}_hip_pitch" type="revolute">
      <parent link="${prefix}_hip_roll"/><child link="${prefix}_hip_pitch"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="360" velocity="2.0"/>
    </joint>
    <link name="${prefix}_thigh">
      <inertial><mass value="${mass_thigh}"/><inertia ixx="0.45" ixy="0" ixz="0" iyy="0.45" iyz="0" izz="0.12"/><origin xyz="0 0 -0.26"/></inertial>
      <visual><origin xyz="0 0 -0.26" rpy="0 0 0"/><geometry><mesh filename="package://ares1_description/meshes/visual/thigh.stl"/></geometry><material name="dark_grey"/></visual>
      <collision><geometry><mesh filename="package://ares1_description/meshes/collision/thigh_col.stl"/></geometry></collision>
    </link>
    <joint name="${prefix}_thigh_joint" type="fixed"><parent link="${prefix}_hip_pitch"/><child link="${prefix}_thigh"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
    <link name="armour_${prefix}_thigh"><inertial><mass value="1.1"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/><origin xyz="0 0 0"/></inertial><visual><origin xyz="0.08 0 -0.26" rpy="0 0 0"/><geometry><box size="0.018 0.12 0.30"/></geometry><material name="flat_black"/></visual></link>
    <joint name="armour_${prefix}_thigh_joint" type="fixed"><parent link="${prefix}_thigh"/><child link="armour_${prefix}_thigh"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
    <link name="${prefix}_shin">
      <inertial><mass value="${mass_shin}"/><inertia ixx="0.28" ixy="0" ixz="0" iyy="0.28" iyz="0" izz="0.09"/><origin xyz="0 0 -0.24"/></inertial>
      <visual><origin xyz="0 0 -0.24" rpy="0 0 0"/><geometry><mesh filename="package://ares1_description/meshes/visual/shin.stl"/></geometry><material name="dark_grey"/></visual>
      <collision><geometry><mesh filename="package://ares1_description/meshes/collision/shin_col.stl"/></geometry></collision>
    </link>
    <joint name="${prefix}_knee" type="revolute">
      <parent link="${prefix}_thigh"/><child link="${prefix}_shin"/>
      <origin xyz="0 0 -0.52" rpy="0 0 0"/>
      <axis xyz="0 1 0"/><limit lower="0" upper="2.443" effort="360" velocity="2.5"/>
    </joint>
    <link name="armour_${prefix}_shin"><inertial><mass value="0.8"/><inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.008"/><origin xyz="0 0 0"/></inertial><visual><origin xyz="0.07 0 -0.24" rpy="0 0 0"/><geometry><box size="0.015 0.10 0.28"/></geometry><material name="flat_black"/></visual></link>
    <joint name="armour_${prefix}_shin_joint" type="fixed"><parent link="${prefix}_shin"/><child link="armour_${prefix}_shin"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
    <!-- ankle pitch -> roll -->
    <link name="${prefix}_ankle_pitch"><inertial><mass value="0.6"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.004"/></inertial></link>
    <joint name="${prefix}_ankle_pitch" type="revolute">
      <parent link="${prefix}_shin"/><child link="${prefix}_ankle_pitch"/>
      <origin xyz="0 0 -0.48" rpy="0 0 0"/>
      <axis xyz="0 1 0"/><limit lower="-0.698" upper="0.698" effort="220" velocity="3.0"/>
    </joint>
    <link name="${prefix}_ankle_roll"><inertial><mass value="0.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.003"/></inertial></link>
    <joint name="${prefix}_ankle_roll" type="revolute">
      <parent link="${prefix}_ankle_pitch"/><child link="${prefix}_ankle_roll"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/><limit lower="-0.349" upper="0.349" effort="160" velocity="3.0"/>
    </joint>
    <link name="${prefix}_foot">
      <inertial><mass value="${mass_foot}"/><inertia ixx="0.04" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.05"/><origin xyz="0.05 0 -0.02"/></inertial>
      <visual><origin xyz="0.05 0 -0.02" rpy="0 0 0"/><geometry><mesh filename="package://ares1_description/meshes/visual/foot.stl"/></geometry><material name="gunmetal"/></visual>
      <collision><geometry><mesh filename="package://ares1_description/meshes/collision/foot_col.stl"/></geometry></collision>
    </link>
    <joint name="${prefix}_foot_joint" type="fixed"><parent link="${prefix}_ankle_roll"/><child link="${prefix}_foot"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  </xacro:macro>

  <xacro:leg prefix="left" y="0.18"/>
  <xacro:leg prefix="right" y="-0.18"/>

  <!-- ========== SENSORS arc.md 530 ========== -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control">
      <parameters>config/ares1_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="head">
    <!-- Livox MID-360 10Hz 360 point cloud on dome -->
    <sensor name="mid360" type="gpu_lidar">
      <lidar><scan><horizontal><samples>1024</samples><min_angle>-3.1416</min_angle><max_angle>3.1416</max_angle></horizontal><vertical><samples>64</samples><min_angle>-0.5236</min_angle><max_angle>0.5236</max_angle></vertical></scan><range><min>0.2</min><max>70</max></range></lidar>
      <always_on>true</always_on><update_rate>10</update_rate><topic>/ares1/sensors/lidar/points</topic>
    </sensor>
    <!-- D435i front -->
    <sensor name="front_stereo" type="camera">
      <camera><image><width>1280</width><height>720</height></image><clip><near>0.1</near><far>80</far></clip></camera>
      <always_on>true</always_on><update_rate>30</update_rate><topic>/ares1/sensors/camera/front/image</topic>
    </sensor>
    <sensor name="thermal" type="camera">
      <camera><image><width>640</width><height>512</height></image></camera>
      <always_on>true</always_on><update_rate>60</update_rate><topic>/ares1/sensors/camera/thermal/image</topic>
    </sensor>
    <sensor name="rear_wide" type="camera">
      <camera><image><width>1920</width><height>1080</height></image><clip><near>0.1</near><far>60</far></clip></camera>
      <always_on>true</always_on><update_rate>60</update_rate><topic>/ares1/sensors/camera/rear/image</topic>
    </sensor>
  </gazebo>

  <gazebo reference="chest">
    <sensor name="imu_chest" type="imu">
      <always_on>true</always_on><update_rate>800</update_rate><topic>/ares1/sensors/imu/data</topic>
    </sensor>
    <sensor name="acoustic_array" type="logical_camera">
      <always_on>true</always_on><update_rate>50</update_rate><topic>/ares1/sensors/acoustic/direction</topic>
    </sensor>
  </gazebo>

  <gazebo reference="left_foot">
    <sensor name="left_ft" type="force_torque"><always_on>true</always_on><update_rate>1000</update_rate><topic>/ares1/sensors/foot/left/ft</topic></sensor>
  </gazebo>
  <gazebo reference="right_foot">
    <sensor name="right_ft" type="force_torque"><always_on>true</always_on><update_rate>1000</update_rate><topic>/ares1/sensors/foot/right/ft</topic></sensor>
  </gazebo>

  <gazebo reference="shield"><material>Gazebo/Charcoal</material></gazebo>
</robot>
