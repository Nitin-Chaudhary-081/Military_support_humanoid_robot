  <!-- Sensor head: camera + lidar (gz sensors) -->
  <gazebo reference="sensor_head">
    <sensor name="head_camera" type="camera">
      <camera>
        <image>
          <width>1280</width>
          <height>720</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>80</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/camera/image_raw</topic>
      <gz:topic xmlns:gz="http://gazebosim.org/schema">/camera/image_raw</gz:topic>
    </sensor>
    <sensor name="head_lidar" type="gpu_lidar">
      <lidar>
        <scan>
          <horizontal>
            <samples>1024</samples>
            <min_angle>-1.5708</min_angle>
            <max_angle>1.5708</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>60</max>
        </range>
      </lidar>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/lidar/points</topic>
    </sensor>
  </gazebo>
